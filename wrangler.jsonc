{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "zerdonghua",
	"compatibility_date": "2026-11-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Workers Builds runs `wrangler deploy` on main but `wrangler versions upload`
	// on other branches; both run this, so .open-next/ exists for either path.
	"build": {
		"command": "npx opennextjs-cloudflare build"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "zerdonghua"
		}
	],
	"images": {
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
